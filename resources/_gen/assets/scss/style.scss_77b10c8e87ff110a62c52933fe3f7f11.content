25s ease}.friend-circle-inline__item:hover{transform:translateY(-2px);box-shadow:var(--shadow-l2)}.friend-circle-inline__item.is-hidden,.friend-circle-inline__empty.is-hidden,.friend-circle-inline__more.is-hidden{display:none!important}.friend-circle-inline__avatar-link{width:42px;height:42px}.friend-circle-inline__avatar{display:block;width:42px!important;height:42px!important;border-radius:12px!important;object-fit:cover;background:rgba(120,130,150,.14)}.friend-circle-inline__body{min-width:0}.friend-circle-inline__body p{display:-webkit-box;overflow:hidden;margin:6px 0 0;color:var(--card-text-color-secondary);font-size:1.35rem;line-height:1.6;word-break:break-word;-webkit-box-orient:vertical;-webkit-line-clamp:3}.friend-circle-inline__meta{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-bottom:5px;color:var(--card-text-color-tertiary);font-size:1.2rem}.friend-circle-inline__meta a{color:var(--accent-color);font-weight:700}.friend-circle-inline__title{display:-webkit-box;overflow:hidden;color:var(--card-text-color-main);font-size:1.5rem;font-weight:700;line-height:1.35;word-break:break-word;-webkit-box-orient:vertical;-webkit-line-clamp:2}.friend-circle-inline__title:hover{color:var(--accent-color)}.friend-circle-inline__date{display:block;margin-top:4px;color:var(--card-text-color-tertiary);font-size:1.2rem;line-height:1.2}.friend-circle-inline__empty{margin:12px 0 0;padding:16px;border:1px dashed rgba(120,130,150,.28);border-radius:12px;color:var(--card-text-color-secondary);text-align:center}.friend-circle-inline__more{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:18px;color:var(--card-text-color-secondary);font-size:1.3rem}.friend-circle-inline__more button{min-height:38px;padding:0 18px;border:1px solid rgba(120,130,150,.24);border-radius:10px;background:var(--card-background);color:var(--card-text-color-main);box-shadow:var(--shadow-l1);cursor:pointer;font:inherit;font-size:1.4rem;font-weight:700;transition:transfor