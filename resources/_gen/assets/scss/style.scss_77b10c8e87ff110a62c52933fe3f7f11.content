odeFoldButton{position:sticky;float:right;margin:10px 16px 14px 0}.reading-progress{position:fixed;top:0;left:0;z-index:2000;width:100%;height:3px;transform:scaleX(0);transform-origin:left center;background:var(--accent-color);box-shadow:0 0 12px rgba(66,136,185,.38);pointer-events:none;transition:transform .12s linear}.encrypt-box{position:relative;overflow:hidden;max-width:680px;min-height:300px;margin:34px auto;padding:34px 285px 34px 30px;border:1px solid rgba(255,132,168,.3);border-radius:24px;background:radial-gradient(circle at 18% 12%,rgba(255,184,210,.38),transparent 30%),linear-gradient(135deg,rgba(255,246,250,.97),rgba(244,249,255,.92));box-shadow:0 18px 44px rgba(88,54,82,.14),var(--shadow-l2);color:var(--card-text-color-main)}.encrypt-box::after{content:"";position:absolute;right:-24px;bottom:-42px;z-index:0;width:300px;height:390px;background:url(/images/eriri-lock.png)no-repeat 100% 100%/contain;opacity:.96;pointer-events:none;filter:drop-shadow(0 18px 24px rgba(121,77,91,.22))}.encrypt-box::before{content:"";position:absolute;inset:auto 0 0 auto;z-index:0;width:340px;height:210px;background:radial-gradient(circle,rgba(255,132,168,.3),transparent 66%);pointer-events:none}.encrypt-box__body{position:relative;z-index:1;min-width:0}.encrypt-box__body h2{margin:4px 0 8px;padding:0;border:0;color:var(--card-text-color-main);font-size:2.2rem;line-height:1.25}.encrypt-box__body h2::before{display:none}.encrypt-box__eyebrow{margin:0;color:#ff78a8;font-size:1.18rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.encrypt-box__hint,.encrypt-box__message{margin:0;color:var(--card-text-color-secondary);font-size:1.38rem;line-height:1.7}.encrypt-box__form{display:grid;grid-template-columns:minmax(0,1fr)48px;gap:12px;margin:16px 0 8px}.encrypt-box__form input,.encrypt-box__form button{min-height:48px;border-radius:999px;font-size:1.5rem}.encrypt-box__form input{width:100%;border:1px solid rgba(255,132,168,.28);background:rgba(255,255,255,.76);padding:0 14px;color:var(--card-text-color-main);outline:none;transition:border-color .2s ease,box-shadow .2s ease}.encrypt-box__form input:focus{border-color:rgba(255,120,168,.72);box-shadow:0 0 0 4px rgba(255,120,168,.13)}.encrypt-box__form button{border:0;background:linear-gradient(135deg,#ff83ad,#ffb6cf);box-shadow:0 12px 24px rgba(255,132,168,.22);color:#fff;cursor:pointer;font-size:2rem;font-weight:900;padding:0;transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}.encrypt-box__form button:hover{transform:translateY(-1px);box-shadow:0 16px 28px rgba(255,132,168,.28);filter:saturate(1.08)}.encrypt-box[data-lock-state=checking] .encrypt-box__form button{cursor:wait;filter:saturate(.75)}.encrypt-box--error{animation:encrypt-shake .34s ease both}.encrypt-box--error .encrypt-box__message{color:#ff668f;font-weight:700}.post-content--unlocked{animation:post-unlock-fade .32s ease both}[data-scheme=dark] .encrypt-box{border-color:rgba(255,132,168,.24);background:radial-gradient(circle at 18% 12%,rgba(255,132,168,.25),transparent 30%),linear-gradient(135deg,rgba(70,58,68,.94),rgba(52,64,78,.92));box-shadow:0 18px 44px rgba(0,0,0,.24),var(--shadow-l2)}[data-scheme=dark] .encrypt-box::after{opacity:.82;filter:drop-shadow(0 18px 28px rgba(0,0,0,.32))}[data-scheme=dark] .encrypt-box__form input{border-color:rgba(255,180,208,.22);background:rgba(255,255,255,8%)}@keyframes encrypt-shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}50%{transform:translateX(7px)}75%{transform:translateX(-4px)}}@keyframes post-unlock-fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@media(max-width:620px){.encrypt-box{min-height:390px;padding:22px 22px 215px;text-align:center}.encrypt-box::after{right:50%;bottom:-50px;width:230px;height:300px;transform:translateX(50%);opacity:.76}.encrypt-box__form{grid-template-columns:1fr}}.running-time{color:var(--card-text-color-secondary);font-weight:400}.running-time .running-days{font-weight:700;co